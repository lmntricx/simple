APP_NAME=Simple
APP_ENV=local
APP_DEBUG=true
APP_URL=http://localhost:8000
APP_TIMEZONE=UTC
# Generate with: php simple key:generate
APP_KEY=
# APP_ROUTE_PREFIX=api
# Proxies/load balancers in front of the app (IPs or CIDRs, comma-separated, or *)
# TRUSTED_PROXIES=10.0.0.0/8

# sqlite (default, zero setup), mysql or pgsql
DB_CONNECTION=sqlite
# DB_DATABASE_PATH=/absolute/path/to/database.sqlite

# DB_CONNECTION=mysql
# DB_HOST=127.0.0.1
# DB_PORT=3306
# DB_DATABASE=simple
# DB_USERNAME=root
# DB_PASSWORD=

# Minutes until API tokens expire (leave unset for no expiry)
# AUTH_TOKEN_EXPIRATION=43200

# Frontend pages used in auth emails
# PASSWORD_RESET_URL=https://app.example.com/reset-password
# EMAIL_VERIFIED_REDIRECT=https://app.example.com/email-verified

# sync (run jobs immediately) or database (run `php simple queue:work`)
QUEUE_CONNECTION=sync

# log (writes to storage/logs/mail.log), smtp or array
MAIL_DRIVER=log
MAIL_FROM_ADDRESS=hello@example.com
MAIL_FROM_NAME=Simple
# MAIL_HOST=smtp.example.com
# MAIL_PORT=587
# MAIL_USERNAME=
# MAIL_PASSWORD=
# MAIL_ENCRYPTION=tls

CORS_ALLOWED_ORIGINS=*
CORS_SUPPORTS_CREDENTIALS=false
