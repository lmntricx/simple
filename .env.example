APP_NAME=Simple
APP_ENV=local
APP_DEBUG=true
APP_URL=http://localhost:8000
APP_TIMEZONE=UTC
# APP_ROUTE_PREFIX=api

# sqlite (default, zero setup), mysql or pgsql
DB_CONNECTION=sqlite
# DB_DATABASE_PATH=/absolute/path/to/database.sqlite

# DB_CONNECTION=mysql
# DB_HOST=127.0.0.1
# DB_PORT=3306
# DB_DATABASE=simple
# DB_USERNAME=root
# DB_PASSWORD=

CORS_ALLOWED_ORIGINS=*
CORS_SUPPORTS_CREDENTIALS=false
