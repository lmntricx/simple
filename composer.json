{
    "name": "lmntricx/simple",
    "description": "Starter app for the Simple PHP framework.",
    "type": "project",
    "license": "MIT",
    "require": {
        "php": ">=8.2",
        "lmntricx/simple-framework": "@dev"
    },
    "require-dev": {
        "phpunit/phpunit": "^11.5"
    },
    "repositories": [
        {
            "type": "path",
            "url": "framework",
            "options": {
                "symlink": true
            }
        }
    ],
    "autoload": {
        "psr-4": {
            "App\\": "app/",
            "Database\\Factories\\": "database/factories/",
            "Database\\Seeders\\": "database/seeders/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "Tests\\": "tests/",
            "Simple\\Tests\\": "framework/tests/"
        }
    },
    "scripts": {
        "test": [
            "phpunit",
            "phpunit -c framework/phpunit.xml"
        ],
        "post-root-package-install": [
            "@php -r \"file_exists('.env') || copy('.env.example', '.env');\""
        ],
        "post-create-project-cmd": [
            "@php simple key:generate"
        ]
    },
    "config": {
        "sort-packages": true,
        "platform": {
            "php": "8.2.0"
        }
    },
    "minimum-stability": "stable",
    "prefer-stable": true
}
