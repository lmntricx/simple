<?xml version="1.0" encoding="UTF-8"?>
<phpunit xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:noNamespaceSchemaLocation="vendor/phpunit/phpunit/phpunit.xsd"
         bootstrap="vendor/autoload.php"
         colors="true"
         cacheDirectory=".phpunit.cache"
         failOnWarning="true"
         failOnRisky="true">
    <testsuites>
        <testsuite name="Unit">
            <directory>tests/Unit</directory>
        </testsuite>
        <testsuite name="Feature">
            <directory>tests/Feature</directory>
        </testsuite>
    </testsuites>

    <source>
        <include>
            <directory>framework</directory>
            <directory>app</directory>
        </include>
    </source>

    <!-- Defaults; CI overrides DB_* to run the suite on MySQL and PostgreSQL. -->
    <php>
        <env name="APP_ENV" value="testing" force="true"/>
        <env name="APP_DEBUG" value="true"/>
        <env name="APP_URL" value="http://simple.test"/>
        <env name="APP_KEY" value="base64:a2tra2tra2tra2tra2tra2tra2tra2tra2tra2tra2s="/>
        <env name="APP_ROUTE_PREFIX" value=""/>
        <env name="DB_CONNECTION" value="sqlite"/>
        <env name="DB_DATABASE_PATH" value=":memory:"/>
        <env name="MAIL_DRIVER" value="array"/>
        <env name="BCRYPT_ROUNDS" value="4"/>
    </php>
</phpunit>
