# Uploaded files are data, never code: don't execute anything in this folder.
Options -ExecCGI -Indexes
RemoveHandler .php .phtml .php3 .php4 .php5 .php7 .php8 .phar .pht .phps .cgi .pl .py
RemoveType .php .phtml .php3 .php4 .php5 .php7 .php8 .phar .pht .phps

<FilesMatch "\.(?i:php\d?|phtml|phar|pht|phps|cgi|pl|py|sh|html?|svg|js)$">
    Require all denied
</FilesMatch>

<IfModule mod_php.c>
    php_flag engine off
</IfModule>
<IfModule mod_php7.c>
    php_flag engine off
</IfModule>

<IfModule mod_headers.c>
    Header set X-Content-Type-Options "nosniff"
    Header set Content-Security-Policy "default-src 'none'; img-src 'self'; media-src 'self'; style-src 'unsafe-inline'; sandbox"
</IfModule>
